{
    "name": "@juannpz/kaiju-items-transformer-v2",
    "version": "0.20.0",
    "license": "MIT",
    "exports": "./mod.ts",
    "imports": {
        "xlsx": "npm:xlsx@^0.18.5"
    },
    "tasks": {
        "test": "deno test --allow-net tests/",
        "check": "deno check mod.ts",
        "lint": "deno lint",
        "fmt": "deno fmt"
    },
    "lint": {
        "exclude": [".kilo"],
        "rules": {
            "tags": [
                "recommended"
            ]
        }
    },
    "fmt": {
        "exclude": [".kilo"],
        "useTabs": false,
        "indentWidth": 4,
        "lineWidth": 100
    },
    "publish": {
        "include": [
            "mod.ts",
            "src/",
            "LICENSE",
            "README.md"
        ],
        "exclude": [
            "tests/"
        ]
    }
}
